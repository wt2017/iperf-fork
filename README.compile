# clean
make distclean
unset CC
unset CXX

# arm64
export CC=aarch64-linux-gnu-gcc
export CXX=aarch64-linux-gnu-g++
./bootstrap.sh 
./configure --host=aarch64-linux-gnu             --prefix=$PWD/install-arm64             --disable-shared             --enable-static             CFLAGS="-static -O2"             LDFLAGS="-static"

make -j 8
make install

# x86-64
./configure \
    --prefix=$PWD/install-x86_64 \
    --disable-shared \
    --enable-static \
    CFLAGS="-static -O2" \
    LDFLAGS="-static"

make -j 8
make install
